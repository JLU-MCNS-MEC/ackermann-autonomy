<?xml version="1.0"?>
<package format="3">
  <name>ackermann_bringup</name>
  <version>0.1.0</version>
  <description>Hardware integration entry points for Ackermann Autonomy.</description>
  <maintainer email="xqiao@todo.todo">xqiao</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ackermann_autonomy</exec_depend>
  <exec_depend>ackermann_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
