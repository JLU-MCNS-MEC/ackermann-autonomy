# Configuration for the ackermann-can systemd service.
# install_can_service.sh copies this to /etc/default/ackermann-can and never overwrites
# an existing file, so the installer can be re-run safely.

# CAN interface name. Must match can_interface in config/chassis.yaml.
CAN_INTERFACE=can0

# CAN bitrate. Must match the rate the chassis bus actually runs at.
# 500 kbps is the recommended starting point for bench bring-up.
CAN_BITRATE=500000
